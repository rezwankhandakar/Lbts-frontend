# Base URL of the LBTS backend API, INCLUDING the version prefix.
# Local development points at the Express server; production points at the
# Render deployment. Vite only exposes variables prefixed with VITE_.
#
# The /api/v1 suffix is required — the client's paths are relative to it, so a
# value ending at /api makes every request 404.
#   local:      http://localhost:5000/api/v1
#   production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# --- Firebase Web SDK -------------------------------------------------------
# Firebase Console > Project settings > General > Your apps > Web app > SDK
# setup and configuration. These values are public by design: they identify
# the project, they do not grant access. Access is controlled by Firebase
# Authentication settings and by the API verifying ID tokens server-side.
#
# Every one of these is read at BUILD time, not at runtime: Vite inlines them
# into the bundle. Changing one on Netlify therefore needs a redeploy, not a
# restart.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
